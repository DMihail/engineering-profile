# Copy to .env.local and fill in values. Never commit .env.local.

# ── Contact form (required for submissions) ────────────────────────────────

NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# Firebase Admin — pick ONE approach:
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY=
# FIREBASE_PRIVATE_KEY_BASE64=

# ── Optional: client Firebase (not required for portfolio UI) ───────────────

# NEXT_PUBLIC_FIREBASE_API_KEY=
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=
# NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
# NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
# NEXT_PUBLIC_FIREBASE_APP_ID=

# ── Optional: inbox reply API + push (companion inbox PWA) ──────────────────

# INBOX_APP_URL=https://your-inbox-app.vercel.app
# INBOX_ALLOWED_UIDS=
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM=
# MAIL_FROM_NAME=
# MAIL_REPLY_TO=

# ── Optional: site extras ─────────────────────────────────────────────────

# NEXT_PUBLIC_CALENDLY_URL=https://calendly.com/your-link
# NEXT_PUBLIC_PROFILE_IMAGE_PATH=/profile.jpg
# SITE_LAST_MODIFIED=2026-05-29
