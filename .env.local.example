# Contact form (required for submissions)
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# Firebase Admin — prefer one JSON line, or project + email + private key
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_PROJECT_ID=
# Fallback only if FIREBASE_PROJECT_ID is unset:
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# FIREBASE_PRIVATE_KEY_BASE64=

# Inbox PWA (required in production)
INBOX_APP_URL=
INBOX_ALLOWED_UIDS=

# Optional — inbox reply SMTP
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
MAIL_FROM_NAME=
MAIL_REPLY_TO=

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

NEXT_PUBLIC_CALENDLY_URL=

# Optional sitemap lastModified override (ISO date)
# SITE_LAST_MODIFIED=2026-08-09

# Comma-separated hosts for `next dev` LAN access (HMR / static)
# ALLOWED_DEV_ORIGINS=192.168.1.144
